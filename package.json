{
  "name": "architext",
  "version": "0.0.0",
  "private": true,
  "description": "Visual architecture editor that scaffolds projects via AI agents",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "dev": "pnpm --filter @architext/web dev",
    "web:dev": "pnpm --filter @architext/web dev",
    "web:build": "pnpm --filter @architext/web build",
    "web:test": "pnpm --filter @architext/web test",
    "web:typecheck": "pnpm --filter @architext/web typecheck",
    "cli:build": "pnpm --filter @architext/cli build",
    "cli:test": "pnpm --filter @architext/cli test",
    "cli:typecheck": "pnpm --filter @architext/cli typecheck",
    "constraints:build": "pnpm --filter @architext/constraints build",
    "constraints:test": "pnpm --filter @architext/constraints test",
    "constraints:typecheck": "pnpm --filter @architext/constraints typecheck",
    "schema:test": "pnpm --filter @architext/schema test",
    "files:test": "pnpm --filter @architext/files-engine test",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
